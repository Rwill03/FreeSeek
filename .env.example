# ==============================================
# Freelance Auto Hunter Configuration
# ==============================================

# LLM API Configuration
# Use either Groq (recommended) or HuggingFace
LLM_PROVIDER=groq
LLM_API_KEY=your_groq_api_key_here

# Groq API (Free): Get key at https://console.groq.com
# HuggingFace API (Free): Get key at https://huggingface.co/settings/tokens

# Job Search Configuration
TARGET_LOCATION=Bruges
LOCATION_RADIUS=30

# Application Limits
MAX_APPLICATIONS_PER_DAY=10

# Auto-Apply Feature
# Set to 'true' to automatically apply to jobs
# Set to 'false' to only generate proposals without applying
ENABLE_AUTO_APPLY=false

# CV/Resume Path
# Path to your CV PDF file
CV_FILE_PATH=./cv.pdf

# Database (Default: SQLite)
# No configuration needed for SQLite
# Database file will be created as: freelance_hunter.db

# Logging
LOG_LEVEL=INFO
